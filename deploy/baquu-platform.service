[Unit]
Description=Baquu Platform - Node.js Application
Documentation=https://github.com/Mishal04/baquu-Platform
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/baquu-platform
ExecStart=/usr/bin/node dist/server.cjs
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Environment
Environment=NODE_ENV=production
Environment=PORT=3001
EnvironmentFile=-/var/www/baquu-platform/.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/www/baquu-platform

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=baquu-platform

[Install]
WantedBy=multi-user.target
