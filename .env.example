# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://sirfpk.com/"

# ADMIN_EMAIL: Admin panel login email. Keep this secret — server-side only.
ADMIN_EMAIL="your-admin-email@example.com"

# ADMIN_PASSWORD: Admin panel login password. Use a strong password (12+ chars).
ADMIN_PASSWORD="your-strong-password-here"

# JWT_SECRET: Secret key used to sign admin session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-long-random-secret-and-paste-here"
